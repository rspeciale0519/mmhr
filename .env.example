# ============================================================================
# MatchMaker HR — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# (.env.example IS committed — keep it in sync when new variables are added.)
#
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets there.
# Local dev runs against the LOCAL Supabase stack (supabase start), not cloud.
# Cloud/staging values live in Vercel env vars, not in this file.
# ============================================================================

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Brand codename (D8) — swappable without a refactor
NEXT_PUBLIC_BRAND_NAME="MatchMaker HR"

# ----------------------------------------------------------------------------
# Supabase — local dev values come from `supabase start` output
# (staging/prod: project URL + keys from the Supabase dashboard → Settings → API)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle migrations/queries (and Payload, same DB)
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# ----------------------------------------------------------------------------
# Supabase (cloud)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ----------------------------------------------------------------------------
# Payload CMS (embedded; uses DATABASE_URL above)
# Any long random string (e.g. `openssl rand -hex 32`)
# ----------------------------------------------------------------------------
PAYLOAD_SECRET=

# ----------------------------------------------------------------------------
# Claude API — research-pipeline extraction (Phase 5)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Firecrawl — research-pipeline crawling (Phase 5)
# ----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------------
# Trigger.dev — background jobs / pipeline scheduler
# Dashboard → Project → API keys (use the DEV secret key locally)
# ----------------------------------------------------------------------------
TRIGGER_SECRET_KEY=

# ----------------------------------------------------------------------------
# Resend — transactional email (invites, notifications, confirmations)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "MatchMaker HR <noreply@yourdomain.com>"
EMAIL_FROM=

# ----------------------------------------------------------------------------
# Beehiiv — newsletter capture (subscriptions API; Send API not used)
# Dashboard → Settings → API. Publication ID looks like pub_xxxxxxxx
# ----------------------------------------------------------------------------
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ----------------------------------------------------------------------------
# Cal.com — advisor meeting booking (hosted embed)
# The embed link, e.g. "your-username/intro-call"
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CALCOM_LINK=
# Optional — only if we later read/manage bookings via API
CALCOM_API_KEY=

# ----------------------------------------------------------------------------
# PostHog — analytics (consent-gated client + server-side capture)
# Project key starts with phc_; host is https://us.i.posthog.com or EU equivalent
# ----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# Sentry — error monitoring
# DSN from Project Settings → Client Keys; auth token only needed for
# sourcemap upload in CI (Settings → Auth Tokens)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Internal
# ----------------------------------------------------------------------------
# Shared secret protecting internal/cron API routes (e.g. `openssl rand -hex 32`)
CRON_SECRET=
