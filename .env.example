# ============================================================================
# MatchMaker HR — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# (.env.example IS committed — keep it in sync when new variables are added.)
#
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets there.
# Local dev runs against the LOCAL Supabase stack (supabase start), not cloud.
# `npm run dev:local` reads local connection values from the running stack.
# It does not write them into this file or .env.local.
# Cloud/staging values live in Vercel env vars, not in this file.
# ============================================================================

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
# Launch candidate shown to users: A (default) or B. Finance and private documents stay hidden.
MMHR_LAUNCH_CANDIDATE=A
# Brand codename (D8) — swappable without a refactor
NEXT_PUBLIC_BRAND_NAME="MatchMaker HR"
# Server-only. Production stays closed until the public-release gate is approved.
PUBLIC_RELEASE_ENABLED=0
# Must match a versioned approval ID that is also committed in application code.
PUBLIC_RELEASE_APPROVAL_ID=

# ----------------------------------------------------------------------------
# Supabase — local dev values come from `supabase start` output
# (staging/prod: project URL + keys from the Supabase dashboard → Settings → API)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AgentID — CLI-managed credentials remain server-only in .env.local.
# Leave the application flag at 0 while hosted-provider sign-in is disabled.
# Provider activation requires a separate request. CLI init must omit --enable-sso.
# Rebuild after changing this flag: sign-in pages may be prerendered.
AGENTID_CLIENT_ID=
AGENTID_CLIENT_SECRET=
AGENTID_SIGN_IN_ENABLED=0

# Server-only restricted worker connection. The local wrapper creates and
# injects an expiring login. Do not give this role table ownership or raw DML.
# Hosted preview: `node scripts/hosted-worker-login.mjs create --project-ref <ref>`
# creates an mmhr_hosted_worker_ login (90 days) and sets this value in Vercel
# Preview (branch develop). Never put a postgres or migration-owner URL here.
# See docs/hosted-bootstrap.md, "Hosted runtime database login".
DATABASE_URL=

# Server-only migration-owner connection. Application processes must not read
# this value. Local: postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Confirm the port with `supabase status` without printing keys.
MIGRATION_DATABASE_URL=
# Required only when running the local-only paired Super Admin bootstrap command.
R1_BOOTSTRAP_LOCAL=0

# ----------------------------------------------------------------------------
# Payload CMS (embedded; uses DATABASE_URL above)
# Any long random string (e.g. `openssl rand -hex 32`)
# ----------------------------------------------------------------------------
PAYLOAD_SECRET=

# ----------------------------------------------------------------------------
# AI service — provider and model use server-side configuration
# ----------------------------------------------------------------------------
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# ----------------------------------------------------------------------------
# External content acquisition — current approved adapter
# ----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------------
# Trigger.dev — background jobs / pipeline scheduler
# Dashboard → Project → API keys (use the DEV secret key locally)
# ----------------------------------------------------------------------------
TRIGGER_SECRET_KEY=
# Server-only. Enable only after this environment passes the R1 worker,
# identity, migration, provider, and recovery checks. Missing or 0 stays off.
IDENTITY_INTENT_WORKER_ENABLED=0

# ----------------------------------------------------------------------------
# Resend — transactional email (invites, notifications, confirmations)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "MatchMaker HR <noreply@yourdomain.com>"
EMAIL_FROM=

# ----------------------------------------------------------------------------
# Beehiiv — newsletter capture (subscriptions API; Send API not used)
# Dashboard → Settings → API. Publication ID looks like pub_xxxxxxxx
# ----------------------------------------------------------------------------
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ----------------------------------------------------------------------------
# Cal.com — advisor meeting booking (hosted embed)
# The embed link, e.g. "your-username/intro-call"
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CALCOM_LINK=
# Optional — only if we later read/manage bookings via API
CALCOM_API_KEY=

# ----------------------------------------------------------------------------
# PostHog — analytics (consent-gated client + server-side capture)
# Project key starts with phc_; host is https://us.i.posthog.com or EU equivalent
# ----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# Sentry — error monitoring
# DSN from Project Settings → Client Keys; auth token only needed for
# sourcemap upload in CI (Settings → Auth Tokens)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Internal
# ----------------------------------------------------------------------------
# Shared secret protecting internal/cron API routes (e.g. `openssl rand -hex 32`)
CRON_SECRET=
